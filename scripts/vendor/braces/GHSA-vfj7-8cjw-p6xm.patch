+/**
+ * Resolve the maximum nesting depth. `options.maxDepth` can only lower it.
+ */
+
+exports.maxDepth = options => {
+  const limit = options && options.maxDepth;
+  if (typeof limit !== 'number' || !(limit >= 0)) return MAX_DEPTH;
+  return Math.min(MAX_DEPTH, Math.floor(limit));
+};
+
+/**
+ * Throw before a recursive walk goes deeper than the maximum depth
+ */
+
+exports.assertDepth = (depth, max) => {
+  if (depth > max) {
+    throw new RangeError(`Input nesting depth exceeds max depth (${max})`);
+  }
+};
