{
  "name": "@rootlco/web",
  "version": "0.1.0",
  "private": true,
  "description": "RootLco frontend application. Independent package boundary — see docs/phase-1/phase-1-25/frontend-architecture.md.",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname localhost --port 3100",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "start": "next start",
    "style:check": "stylelint \"src/**/*.scss\" --max-warnings 0",
    "style:fix": "stylelint \"src/**/*.scss\" --fix",
    "style:lint": "stylelint \"src/**/*.scss\"",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=json --outputFile.json=vitest-web.json --coverage --coverage.reportsDirectory=coverage/web --coverage.reporter=json-summary --coverage.reporter=json --coverage.reporter=html --coverage.reporter=text-summary",
    "test:e2e": "playwright test",
    "test:e2e:authenticated": "playwright test --project=authenticated-en --project=authenticated-ar --project=authenticated-tablet",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:boundary": "node scripts/check-api-boundary.mjs",
    "validate:brand": "node scripts/check-brand-isolation.mjs",
    "validate:theme": "node scripts/check-tailwind-theme.mjs",
    "validate:tokens": "node scripts/generate-design-tokens.mjs --check && node scripts/check-design-tokens.mjs"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "^3.10.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "@mui/stylis-plugin-rtl": "9.4.0",
    "@mui/system": "9.4.0",
    "@mui/x-charts": "9.14.0",
    "@mui/x-data-grid": "9.14.0",
    "@mui/x-date-pickers": "9.14.0",
    "@mui/x-tree-view": "9.14.0",
    "dayjs": "1.11.23",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "stylis": "4.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/stylis": "4.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "sass": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "vitest-axe": "^1.0.0-pre.3"
  }
}
