# =============================================================================
# apps/web — example environment. Copy to .env.local and adjust LOCAL values.
#
#     cp apps/web/.env.example apps/web/.env.local
#
# Never commit .env.local. Never put a production value here.
# =============================================================================

# ---------------------------------------------------------------------------
# BROWSER-SAFE (NEXT_PUBLIC_*) — inlined into the client bundle at BUILD time.
# The complete list the browser is allowed to know lives in src/lib/env.ts.
# ---------------------------------------------------------------------------

# Where the web tier reaches the API. Local default matches the launcher
# (scripts/dev/dev-config.mjs API_ORIGIN): localhost on 3000.
#
# `localhost`, never 127.0.0.1. This value is inlined into the client bundle, so
# it is the address the BROWSER calls; the page is served from
# http://localhost:3100 and the two are different origins by host string
# (P1-26-F-048 / P1-26-F-062). The CSP connect-src is derived from it as well.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# local | preview | production
NEXT_PUBLIC_APP_ENV=local

# Where client-side diagnostics are delivered, if a deployment operates a
# collector. LEAVE IT UNSET unless one exists: unset means no adapter is
# installed, nothing is sent, and the Content-Security-Policy is byte-identical.
#
# Setting it does two things together, which is why it is one variable: the
# monitoring adapter delivers to it with `navigator.sendBeacon`, and its ORIGIN
# is added to `connect-src` by `src/lib/security/csp.ts` — without which the
# browser would block every beacon. The path is discarded from the policy; only
# the origin is named.
#
# It is inlined at BUILD time like every NEXT_PUBLIC_ value, so setting it on a
# running deployment changes nothing until the next `next build`.
#
# No monitoring service is provisioned and none is claimed to be. This is the
# boundary a deployment opts into, not evidence that one is operating.
# NEXT_PUBLIC_CLIENT_MONITORING_URL=

# ---------------------------------------------------------------------------
# SERVER-ONLY — read at REQUEST time on the server, never shipped to a browser.
# ---------------------------------------------------------------------------

# Opens the internal component gallery at /<locale>/gallery. Deliberately NOT
# NEXT_PUBLIC_: the decision is made per request on the server (P1-25-F-018/019).
# Leave unset in production.
ROOTLCO_ENABLE_GALLERY=true
