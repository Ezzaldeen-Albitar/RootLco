# =============================================================================
# apps/web — example environment. Copy to .env.local and adjust LOCAL values.
#
#     cp apps/web/.env.example apps/web/.env.local
#
# Never commit .env.local. Never put a production value here.
# =============================================================================

# ---------------------------------------------------------------------------
# BROWSER-SAFE (NEXT_PUBLIC_*) — inlined into the client bundle at BUILD time.
# The complete list the browser is allowed to know lives in src/lib/env.ts.
# ---------------------------------------------------------------------------

# Where the web tier reaches the API. Local default matches the launcher
# (scripts/dev/dev-config.mjs): API on 3000.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# local | preview | production
NEXT_PUBLIC_APP_ENV=local

# ---------------------------------------------------------------------------
# SERVER-ONLY — read at REQUEST time on the server, never shipped to a browser.
# ---------------------------------------------------------------------------

# Opens the internal component gallery at /<locale>/gallery. Deliberately NOT
# NEXT_PUBLIC_: the decision is made per request on the server (P1-25-F-018/019).
# Leave unset in production.
ROOTLCO_ENABLE_GALLERY=true
