# =============================================================================
# apps/api — example environment. Copy to .env.local and adjust LOCAL values.
#
#     cp apps/api/.env.example apps/api/.env.local
#
# Never commit .env.local. Never put a production value here.
# The authoritative contract is src/config/env.ts — names below, values yours.
# =============================================================================

# ---------------------------------------------------------------------------
# BROWSER-SAFE (NEXT_PUBLIC_*)
# ---------------------------------------------------------------------------

# Local Supabase stack (supabase start).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The anon key printed by `supabase status`. Public BY DESIGN — its safety is
# Row-Level Security, not secrecy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# local | development | staging | production
NEXT_PUBLIC_APP_ENV=local

# ---------------------------------------------------------------------------
# SERVER-ONLY — never expose, never log, never prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Bypasses RLS entirely. Local value comes from `supabase status`.
# SUPABASE_SERVICE_ROLE_KEY=

# Direct database connection for the API's own pool. Use a LOGIN role that is
# a member of app_runtime (NOSUPERUSER, NOBYPASSRLS) — readiness refuses a
# BYPASSRLS role. Compose it from the values `supabase status` prints:
# Shape: a postgresql:// URL for host 127.0.0.1, port 54322, database postgres,
# with the runtime login and its password. No example URL appears here on
# purpose: the tracked-secrets gate rejects credential-shaped URLs even as
# placeholders, and it is right to.
# DATABASE_URL=
