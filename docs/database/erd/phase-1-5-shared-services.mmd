  DOCUMENT_CATEGORIES {
    uuid id PK
    text scope "platform|tenant"
    uuid tenant_id FK "NULL when platform (nullable exception)"
    text category_code "partial-unique per scope"
    text default_classification
    text default_retention_class
  }
  DOCUMENTS {
    uuid id PK
    uuid tenant_id FK "candidate key (tenant_id, id)"
    uuid category_id FK
    text classification
    text retention_class FK
    boolean legal_hold "default false"
    text status "pending|accepted|quarantined|archived"
  }
  DOCUMENT_VERSIONS {
    uuid id PK
    uuid tenant_id FK
    uuid document_id FK "(tenant_id, document_id)"
    integer version_number "unique per document"
    text storage_key "opaque metadata, not an auth token"
    bytea sha256 "32 bytes"
    text status "pending->accepted|quarantined|rejected"
  }
  FILE_SCAN_RESULTS {
    uuid id PK
    uuid tenant_id FK
    uuid version_id FK "(tenant_id, version_id)"
    text scan_status "pending|clean|infected|error"
  }
  DOCUMENT_LINKS {
    uuid id PK
    uuid tenant_id FK
    uuid document_id FK "(tenant_id, document_id)"
    text entity_type "schema.table token (generic)"
    uuid entity_id
    timestamptz deleted_at "soft delete"
  }
  RETENTION_CLASSES {
    text class_code PK "5 platform reference rows"
    boolean allows_deletion
    integer min_retention_days "NULL = indefinite"
  }
  LEGAL_HOLDS {
    uuid id PK
    uuid tenant_id FK
    uuid document_id FK "one active hold per document"
    timestamptz released_at "NULL = active"
  }
  MESSAGE_TEMPLATES {
    uuid id PK
    text scope "platform|tenant"
    uuid tenant_id FK "NULL when platform (nullable exception)"
    text channel "email|in_app"
    text purpose "transactional|marketing|system"
    text locale_code FK
    uuid active_version_id FK "(id, active_version_id) approved-only"
  }
  TEMPLATE_VERSIONS {
    uuid id PK
    uuid tenant_id FK "mirrors template (nullable exception)"
    uuid template_id FK "candidate key (template_id, id)"
    bytea content_hash "32 bytes"
    text status "draft->approved->retired (immutable once not draft)"
  }
  OUTBOUND_MESSAGES {
    uuid id PK
    uuid tenant_id FK
    uuid template_version_id FK "approved + scoped guard"
    bytea recipient_digest "32 bytes, or recipient_user_id"
    uuid recipient_user_id FK "(tenant_id, recipient_user_id)"
    bytea body_sha256 "content hash only; body not stored"
    text dedupe_key "unique per tenant"
    text status "pending|queued|sending|sent|delivered|failed|cancelled"
  }
  DELIVERY_ATTEMPTS {
    uuid id PK
    uuid tenant_id FK
    uuid message_id FK "(tenant_id, message_id)"
    integer attempt_number "unique per message; append-only"
    text status "started|accepted|delivered|errored"
  }
  EVENT_OUTBOX {
    uuid id PK
    uuid tenant_id FK
    text event_key "unique per tenant"
    integer schema_version
    bigint aggregate_version
    jsonb payload "object; no secrets"
    text status "pending|claimed|published|dead_letter"
    text claimed_by "worker claimant; SKIP LOCKED"
  }
  PROCESSED_EVENTS {
    text consumer_code PK "PK (consumer_code, event_id)"
    uuid event_id PK
    uuid tenant_id FK "NULL = platform (nullable exception)"
    text outcome "applied|skipped|failed"
  }
  ERROR_RECORDS {
    uuid id PK
    uuid tenant_id FK "NULL pre-context (nullable exception)"
    text severity "info|warning|error|critical"
    jsonb context "recursively sanitized"
    text status "open->acknowledged->resolved"
  }
  SYSTEM_SETTINGS {
    uuid id PK
    text scope "platform|tenant"
    uuid tenant_id FK "NULL when platform (nullable exception)"
    text setting_key
    integer version "immutable versioned rows"
  }
  LOCALIZATION_KEYS {
    uuid id PK
    text key_code UK "platform catalogue (no tenant)"
    text status "active|deprecated"
  }
  LOCALIZED_TEXTS {
    uuid id PK
    uuid key_id FK
    text locale_code FK
    text status "draft->approved->retired; one approved per key/locale"
  }
  SEARCH_METADATA {
    uuid id PK
    uuid tenant_id FK
    text entity_type
    uuid entity_id
    text field_code
    text locale_code FK "identity: NULLS NOT DISTINCT"
    text classification "sensitive-read gated"
  }
  TAGS {
    uuid id PK
    uuid tenant_id FK "tenant-only (no platform catalogue)"
    text tag_code "active-unique per tenant"
  }
  ENTITY_TAGS {
    uuid id PK
    uuid tenant_id FK
    uuid tag_id FK "(tenant_id, tag_id)"
    text entity_type
    uuid entity_id
  }
  NOTES {
    uuid id PK
    uuid tenant_id FK
    uuid author_id FK "(tenant_id, author_id)"
    text classification "sensitive-read gated"
    text visibility "internal|customer_visible"
  }
  COMMENTS {
    uuid id PK
    uuid tenant_id FK "candidate key (tenant_id, id)"
    uuid author_id FK "(tenant_id, author_id)"
    uuid parent_comment_id FK "same tenant + entity guard"
    text status "active|hidden"
  }
