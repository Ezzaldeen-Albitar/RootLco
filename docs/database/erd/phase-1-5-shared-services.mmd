  TENANTS ||--o{ EVENT_OUTBOX : "tenant_id"
  LEGAL_COMPANIES ||--o{ EVENT_OUTBOX : "(tenant_id, company_id)"
  BRANCHES ||--o{ EVENT_OUTBOX : "(tenant, company, branch)"

