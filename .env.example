# =============================================================================
# RootLco — Root Link Company
# ROOT environment example. Copy to .env.local and fill in LOCAL values only.
#
#     cp .env.example .env.local
#
# =============================================================================
# WHAT THIS FILE IS FOR — read this before adding anything to it.
#
# EXACTLY ONE consumer reads the root `.env.local`: the `env_file:` entry in
# `docker-compose.yml`. Nothing else does.
#
# The two application processes do NOT read it. Next.js loads `.env.local` from
# the application directory it is started in, and the launcher
# (`scripts/dev/start-local.mjs`) starts them as `next dev apps/api` and
# `next dev apps/web`. So:
#
#   running with `npm run dev`  → apps/api/.env.local and apps/web/.env.local
#   running with docker compose → this file's .env.local, for the container
#
# Repository scripts (`scripts/**`) read `process.env` directly with hard-coded
# local defaults and load no dotenv file at all, so a value set here reaches a
# script only if it is already exported in your shell.
#
# THE TWO TEMPLATES THAT MATTER:
#   apps/api/.env.example  — the API tier. Every name its two schemas read.
#   apps/web/.env.example  — the web tier. The browser-safe list plus two
#                            server-only switches.
#
# The complete inventory, with the consumer and the source of each value, is
# docs/platform/environment-configuration.md.
#
# Never commit .env, .env.local, or any file containing real values.
# Never put a production value in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# BROWSER-SAFE (NEXT_PUBLIC_*)
#
# Anything prefixed NEXT_PUBLIC_ is INLINED INTO THE BROWSER BUNDLE by Next.js
# at build time and is therefore PUBLIC. Never give this prefix to a secret.
# -----------------------------------------------------------------------------

# Supabase API URL.
#   Host / browser  -> http://127.0.0.1:54321
#   From INSIDE the web container, 127.0.0.1 is the container itself, so the
#   compose file overrides this to http://host.docker.internal:54321.
#   See docs/phase-1/phase-1-1/docker-runbook.md ("Two hostnames, one Supabase").
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anonymous key. Public BY DESIGN: it identifies the project, it does
# not authorise access. Its safety depends entirely on Row-Level Security, which
# is implemented and forced on every tenant-scoped table (ADR-004).
#
# Get the real local value with:  npm run supabase:status
NEXT_PUBLIC_SUPABASE_ANON_KEY=read-the-local-anon-key-from-supabase-status

# Which environment this build represents.
#   apps/api vocabulary: local | development | staging | production
#   apps/web vocabulary: local | preview | production
# Only "local" exists. No staging and no production environment is provisioned
# (ADR-012), and the deployment workflows are inert.
NEXT_PUBLIC_APP_ENV=local

# Optional build identity, surfaced by /api/health. Injected at image build.
# NEXT_PUBLIC_APP_VERSION=
# NEXT_PUBLIC_COMMIT_SHA=

# -----------------------------------------------------------------------------
# COMPOSE-ONLY
# -----------------------------------------------------------------------------

# Substituted by docker-compose.yml into the container's environment so the
# server side can reach the host's Supabase. NO APPLICATION SOURCE READS IT —
# it is a compose-level value and nothing more.
# SUPABASE_INTERNAL_URL=http://host.docker.internal:54321

# -----------------------------------------------------------------------------
# SERVER-ONLY — NEVER prefix these with NEXT_PUBLIC_
#
# Set these here only when you run the application under docker compose. For
# `npm run dev`, they belong in apps/api/.env.local, and apps/api/.env.example
# is the template that documents the full set.
# -----------------------------------------------------------------------------

# Supabase service-role key. BYPASSES ROW-LEVEL SECURITY ENTIRELY.
# Treat as a root credential: never log it, never send it to the browser, never
# commit it, never paste it into an issue.
# SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection for the API's own pool. A postgresql:// URL for
# host 127.0.0.1, port 54322, database postgres, using a login role that is a
# member of app_runtime and holds no BYPASSRLS. No example URL appears here on
# purpose: the tracked-secrets gate rejects credential-shaped URLs even as
# stand-ins, and it is right to.
# DATABASE_URL=

# Server log verbosity: debug | info | warn | error. Read by
# apps/api/src/server/observability/logger.ts. Unset falls back to the built-in
# default (warn under test, info otherwise).
# LOG_LEVEL=

# OBJECT STORAGE, AND WHY IT IS NOT LISTED HERE.
#
# The attachment settings (the STORAGE_ family) are real inputs to the container
# too, and they are deliberately documented in ONE place — apps/api/.env.example,
# which is the template for the tier that reads them. Locally they are not typed
# at all: scripts/dev/storage-env.mjs derives them from the running stack and the
# launcher hands them to the API process only.
#
# If you run under docker compose and need attachments, copy the block from
# apps/api/.env.example into your .env.local. Nothing is lost by their absence
# from this file: the schema still accepts every one of them.

# -----------------------------------------------------------------------------
# ROTATION EXPECTATIONS
#
# - Local keys are generated by the Supabase CLI and are not secret across
#   developers; they are worthless outside your machine.
# - Any NON-LOCAL key must be rotated: on suspected exposure, immediately; when a
#   person with access leaves, immediately; otherwise on a schedule the owners set.
# - If a real secret is ever committed: ROTATE FIRST, then purge history. Do not
#   re-post the value anywhere — not in an issue, a PR, a log, or a report.
# - Reporting channel: see SECURITY.md.
# -----------------------------------------------------------------------------
